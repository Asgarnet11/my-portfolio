# ==============================================================
# My Portfolio - Environment Variables Template
# ==============================================================

# Server / Backend Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Supabase Database & Storage Configuration
# Dapatkan dari Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Authentication & Security
# Generate dengan `openssl rand -base64 32`
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# Initial Admin Seeding Configuration
ADMIN_EMAIL=afatwahyudi@gmail.com
ADMIN_PASSWORD=yourSecureAdminPassword123
ADMIN_NAME=Muh Asgar Fatwahyudi

# Client / Frontend Vite Configuration
VITE_API_URL=http://localhost:5000/api/v1
